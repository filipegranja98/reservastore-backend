# Copy to reservastoresupa/.env.local; loading requires DJANGO_LOAD_DOTENV=true.
# Generate a fresh key and replace the blank value before running.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_ENGINE=sqlite
# PostgreSQL is opt-in only. Never use production credentials for tests.
# DJANGO_DB_NAME=
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432

# Enable only after configuring and testing your SMTP provider.
DJANGO_ACCOUNT_RECOVERY_ENABLED=false
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=

# Resend: use a key and verified sender configured for Reserva Store.
DJANGO_RESEND_API_KEY=
# DJANGO_DEFAULT_FROM_EMAIL=Reserva Store <contato@seu-dominio-verificado>
# Production hosting
DJANGO_TRUST_PROXY_SSL=false
# Set to the persistent volume mount path for store and product images.
# DJANGO_MEDIA_ROOT=/data/media
